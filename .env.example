TELEGRAM_BOT_PROJECT_NAME=telegram-bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CONFIG_PATH=./config
DOCKER_SOCKET_PATH=/var/run/docker.sock
BOT_HOST_ACTION_SOCKET=/var/run/telegram-bot/host-actions.sock
BOT_HOST_ACTIONS_PORT=8787
BOT_HOST_ACTION_ENDPOINT=host.docker.internal:${BOT_HOST_ACTIONS_PORT}
HOST_ACTIONS_CONFIG=${CONFIG_PATH}/host-actions.yaml
# HTTP API, published on 127.0.0.1 only. Keys: make api-key USER_ID=<telegram_user_id>
API_PORT=8080

# Config-builder settings for bot actions
ACTIONS_BASE_DIR=../..
BOT_ACTIONS_INPUT_DIR=storage/templates/actions
BOT_ACTIONS_INPUT_GLOB=${BOT_ACTIONS_INPUT_DIR}/*.{json,yaml,yml}
BOT_ACTIONS_OUTPUT_PATH=storage/config/bot/actions.yaml
BOT_ACTIONS_DUPLICATES_REPORT=tmp/build/action-duplicates.json
BOT_ACTIONS_SUMMARY_JSON=tmp/build/action-summary.json

# Config-builder settings for host actions
HOST_ACTIONS_INPUT_DIR=storage/templates/host-actions
HOST_ACTIONS_INPUT_GLOB=${HOST_ACTIONS_INPUT_DIR}/*.{json,yaml,yml}
HOST_ACTIONS_OUTPUT_PATH=storage/config/host/host-actions.yaml
HOST_ACTIONS_DUPLICATES_REPORT=tmp/build/host-action-duplicates.json
HOST_ACTIONS_SUMMARY_JSON=tmp/build/host-action-summary.json

# Tailscale TSDPROXY related
TSDPROXY_ENABLE=true
TSDPROXY_NAME=telegram-bot-api
TSDPROXY_EPHEMERAL=true
TSDPROXY_TAGS=telegram,bot,api

# Cloudflare Tunnel configuration
CF_ZONE_ID=<your_cloudflare_zone_id_here>
CF_TUNNEL_ID=<your_cloudflare_tunnel_id_here>
CF_TUNNEL_CNAME="${CF_TUNNEL_ID}.cfargotunnel.com"

ARCANE_CF_ROUTE_ENABLED=true
ARCANE_CF_ROUTE_NAMES=<your_cloudflare_route_names_here>
ARCANE_CF_ROUTE_PROXIED=true
ARCANE_CF_ROUTE_DELETE_ON_STOP=true